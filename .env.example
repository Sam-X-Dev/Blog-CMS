# Neon Postgres pooled connection URL (host contains "-pooler")
DATABASE_URL="postgresql://neondb_owner:password@ep-cool-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres direct connection URL (for migrations)
DIRECT_URL="postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="your_jwt_secret_here"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
