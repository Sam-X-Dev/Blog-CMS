// owners Admin/Blog/Tag = Samarth, Category/Media = Abhishek; tell your teammate before changing this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  content     String // editor HTML
  thumbnail   String? // required only when publishing (checked in API)
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  isTrending  Boolean    @default(false) // admin pick for the Trending page (Abhishek)
  isFeatured  Boolean    @default(false) // admin pick for the homepage hero (Abhishek)
  seoTitle       String? // optional <title> for search engines (falls back to the title)
  seoDescription String? // optional meta description (falls back to the description)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       Tag[]
  views      BlogView[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([isFeatured])
}


model BlogView {
  blogId String
  day    DateTime @db.Date
  count  Int      @default(0)
  blog   Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@id([blogId, day])
  @@index([day])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  blogs     Blog[]
}

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  width     Int?
  height    Int?
  format    String?
  bytes     Int?
  createdAt DateTime @default(now())
}
